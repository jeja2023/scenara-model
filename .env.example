# 景枢模型平台环境变量示例
# 复制为 .env 后按本地或部署环境调整。
SCENARA_MODEL_WORKSPACE=.
SCENARA_MODEL_METADATA_DB=artifacts/scenara_model.sqlite3
# 使用 PostgreSQL 元数据存储时，可改用下面的连接字符串。
# SCENARA_MODEL_METADATA_DB=postgresql://user:password@db:5432/scenara_model
SCENARA_MODEL_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
# 独立前端仅为迁移期兼容实现。统一 Console 由 scenara 提供，默认不启用。
SCENARA_MODEL_SERVE_FRONTEND=false
SCENARA_MODEL_FRONTEND_DIST=frontend/dist
SCENARA_MODEL_MAX_PACKAGE_SCAN_FILES=500
SCENARA_MODEL_MAX_UPLOAD_BYTES=524288000
SCENARA_MODEL_STORAGE_BACKEND=local
SCENARA_MODEL_STORAGE_URI=artifacts/object-store
# 使用 S3/MinIO 时，将 SCENARA_MODEL_STORAGE_BACKEND 设置为 s3 或 minio，并使用类似 s3://bucket/prefix 的 URI。
# SCENARA_MODEL_S3_ENDPOINT_URL=http://127.0.0.1:9000
# SCENARA_MODEL_S3_REGION=us-east-1
# SCENARA_MODEL_S3_ACCESS_KEY_ID=minioadmin
# SCENARA_MODEL_S3_SECRET_ACCESS_KEY=minioadmin
SCENARA_MODEL_PIPELINE_WORKERS=2
SCENARA_MODEL_EXTERNAL_COMMAND_TIMEOUT_SECONDS=3600
SCENARA_MODEL_EXTERNAL_COMMAND_LOG_MAX_CHARS=20000
SCENARA_MODEL_ALLOW_SHELL_COMMANDS=false
# 在共享环境或生产环境中请设置高强度令牌（供 CI/脚本等自动化调用，与登录会话互不影响）。
# SCENARA_MODEL_AUTH_TOKEN=change-me
# 首次启动自动创建 admin 账户的初始密码；未设置时自动生成随机口令并打印到启动日志。
# 之后修改密码请使用：scenara-model user set-password --username admin --password <新密码>
# SCENARA_MODEL_ADMIN_PASSWORD=change-me
# 登录会话有效期（小时），默认 24。
# SCENARA_MODEL_SESSION_TTL_HOURS=24
# 登录失败限流：同一用户名+IP 连续失败达上限后锁定指定秒数。
# SCENARA_MODEL_LOGIN_MAX_FAILURES=5
# SCENARA_MODEL_LOGIN_LOCKOUT_SECONDS=300
# 任务日志与审计事件保留天数，以及周期维护间隔（秒）。
# SCENARA_MODEL_LOG_RETENTION_DAYS=30
# SCENARA_MODEL_MAINTENANCE_INTERVAL_SECONDS=3600
# 显式放行给外部训练命令的环境变量名（逗号分隔）；平台配置与凭证默认全部剥离。
# SCENARA_MODEL_EXTERNAL_COMMAND_ENV_PASSTHROUGH=HF_TOKEN
# Core 的 deployment-feedback 事件使用 HMAC-SHA256 签名；生产环境必须配置与 Core Webhook 订阅相同的强随机密钥。
# SCENARA_MODEL_DEPLOYMENT_FEEDBACK_SECRET=change-me
# 拒绝超出此时间窗的回放请求，单位为秒。
# SCENARA_MODEL_DEPLOYMENT_FEEDBACK_MAX_AGE_SECONDS=300
