# Single-host production image built locally from the full Git commit SHA.
SCENARA_MODEL_IMAGE=scenara-model:replace-with-git-commit-sha
SCENARA_PLATFORM_NETWORK=scenara-platform
SCENARA_MODEL_DATA_PLATFORM_URL=https://data.internal.example
SCENARA_MODEL_CORS_ORIGINS=https://scenara.example.com
SCENARA_MODEL_STORAGE_BACKEND=minio
SCENARA_MODEL_STORAGE_URI=minio://scenara-model-artifacts/models
SCENARA_MODEL_S3_ENDPOINT_URL=https://minio.internal.example
SCENARA_MODEL_S3_REGION=us-east-1
