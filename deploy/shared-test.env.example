# Must match scenara/deploy/shared-infra/.env.example.
SCENARA_PLATFORM_NETWORK=scenara-platform
SCENARA_MODEL_DB_PASSWORD=replace-with-model-db-password
SCENARA_MODEL_S3_ACCESS_KEY=scenara-model
SCENARA_MODEL_S3_SECRET_KEY=replace-with-model-s3-secret

# Core -> Model delegated API test credentials.
SCENARA_MODEL_SERVICE_TOKEN=replace-with-core-to-model-token
SCENARA_MODEL_CONTEXT_SIGNING_KEY=replace-with-core-to-model-context-key

# Model -> Data credentials; the token must be in Data's trusted allowlist.
SCENARA_MODEL_DATA_PLATFORM_SERVICE_TOKEN=replace-with-model-to-data-token
SCENARA_DATA_CONTEXT_SIGNING_KEY=replace-with-shared-data-context-key
SCENARA_MODEL_DEPLOYMENT_FEEDBACK_SECRET=replace-with-core-webhook-secret
