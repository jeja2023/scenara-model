# scenara model 独立训练模式。
# Model 独立负责训练、实验、模型包和 Job；Dataset Version 仍从 scenara-data 读取。
# 模型发布、激活、灰度和 Core 在线推理治理仍由 scenara Core 负责。
SCENARA_MODEL_IMAGE=scenara-model:<git-commit-sha>
SCENARA_PLATFORM_NETWORK=scenara-platform
SCENARA_PLATFORM_CERTS_DIR=/secure/scenara-certs
SCENARA_PLATFORM_CA_FILE=/run/tls/ca.crt
SCENARA_MODEL_HTTP_PORT=8080

SCENARA_MODEL_DATA_PLATFORM_URL=https://data.scenara.internal:8081
SCENARA_MODEL_STORAGE_BACKEND=minio
SCENARA_MODEL_STORAGE_URI=minio://scenara-model-artifacts/models
SCENARA_MODEL_S3_ENDPOINT_URL=https://minio.scenara.internal:9000
SCENARA_MODEL_S3_REGION=us-east-1
SCENARA_MODEL_CORS_ORIGINS=https://model.scenara.internal:8080
